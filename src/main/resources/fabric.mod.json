{
  "schemaVersion": 1,
  "id": "meteor-valley-builder",
  "version": "${version}",
  "name": "Meteor Valley Builder",
  "description": "A Meteor addon that lets you easily build valleys (e.g valley of furnaces).",
  "authors": ["dinosaurwizard"],
  "contact": {
    "repo": "https://github.com/habue/meteor-valley-builder",
    "sources": "https://github.com/habue/meteor-valley-builder",
    "issues": "https://github.com/habue/meteor-valley-builder/issues"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": ["dinosaurwizard.valleybuilder.ValleyBuilderAddon"]
  },
  "mixins": [],
  "custom": {
    "meteor-client:color": "255,140,0",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=25",
    "minecraft": ["${mc_version}"],
    "fabricloader": ">=0.19.2",
    "meteor-client": ">=26.1.2- <26.2-"
  }
}
